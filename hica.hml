@project {
    name: "hica-launcher"
    version: "0.1.0"
    license: "MIT"
    entry: "src/main.hc"
}

@dependencies {
    imgui: "latest"
    hml: "latest"
}

@description {
    summary: "A launcher for the hica ecosystem"
    author: "cladam"
    homepage: "https://www.hica.dev"
    repository: "https://github.com/cladam/hica-launcher"
}

@koka {
    include: "src"
    flags: "--cclinkopts=-Llib --cclinkopts=-L/opt/homebrew/opt/sdl2/lib --cclinkopts=-limgui_hica --cclinkopts=-lSDL2 --cclinkopts=-lc++ --cclinkopts=-framework --cclinkopts=OpenGL"
}